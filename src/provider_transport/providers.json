{
  "schema_version": 3,
  "wire_version": 3,
  "providers": {
    "codex": {
      "transport": "codex-app-server",
      "command_prefix": ["codex", "app-server", "-c", "thread_unload_delay_secs=0"],
      "command_base": "path",
      "bindings": {"session": ["model", "effort"], "required": []},
      "skill_exclusion": "codex-skills-config",
      "conformance": {"generation": "codex-app-server:v2"}
    },
    "claude": {
      "transport": "acp-v1",
      "command_prefix": ["launchers/claude_agent_acp.py"],
      "command_base": "subsession-python",
      "bindings": {"session": ["model", "effort"], "required": ["model"]},
      "skill_exclusion": "claude-disallowed-skills",
      "conformance": {
        "generation": "claude-agent-acp:v1"
      }
    },
    "pi": {
      "transport": "pi-rpc",
      "command_prefix": ["pi", "--mode", "rpc"],
      "command_base": "path",
      "bindings": {"session": ["model", "effort"], "required": []},
      "skill_exclusion": "pi-exclude-skills",
      "conformance": {"generation": "pi-rpc:v1"}
    }
  }
}
